<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#1F019889" />
            <stroke android:width="1.5dp" android:color="#019889" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#E0F2F1" />
            <stroke android:width="1dp" android:color="#019889" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#F0F4F8" />
            <stroke android:width="1dp" android:color="#CFD8DC" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
