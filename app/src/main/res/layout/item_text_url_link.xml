<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/panel_bg_all_20_1f1f1f"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Type Badge -->
    <TextView
        android:id="@+id/tv_link_type"
        android:layout_width="56dp"
        android:layout_height="26dp"
        android:background="@drawable/bg_badge_pill"
        android:gravity="center"
        android:textColor="@color/white"
        android:textSize="11sp"
        android:textStyle="bold"
        tools:text="WEB" />

    <!-- Link URL / Target -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_link_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="middle"
            android:singleLine="true"
            android:textColor="#03DAC5"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="https://github.com" />

        <TextView
            android:id="@+id/tv_link_target"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:textColor="#9AA0A6"
            android:textSize="11sp"
            tools:text="目標: https://github.com" />
    </LinearLayout>

    <!-- Open Action Button -->
    <Button
        android:id="@+id/btn_open_link"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_btn_primary"
        android:minWidth="54dp"
        android:paddingHorizontal="8dp"
        android:text="開啟"
        android:textColor="@color/white"
        android:textSize="12sp" />

    <!-- Copy Action Button -->
    <Button
        android:id="@+id/btn_copy_link"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:background="@drawable/bg_btn_cancel"
        android:minWidth="54dp"
        android:paddingHorizontal="8dp"
        android:text="複製"
        android:textColor="@color/white"
        android:textSize="12sp" />

</LinearLayout>
