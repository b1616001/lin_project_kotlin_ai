<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
  >




    <!-- Top Action Buttons -->
    <Button
        android:id="@+id/btn_insert"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="新增帳號"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="8dp"
        android:layout_marginStart="8dp" />

    <Button
        android:id="@+id/btn_query"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="搜尋"
        app:layout_constraintTop_toTopOf="@+id/btn_insert"
        app:layout_constraintStart_toEndOf="@+id/btn_insert"
        android:layout_marginStart="8dp" />

    <Button
        android:id="@+id/btn_clearTable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="清空資料庫"
        app:layout_constraintTop_toTopOf="@+id/btn_insert"
        app:layout_constraintStart_toEndOf="@+id/btn_query"
        android:layout_marginStart="8dp" />

    <!-- Selected User Info Display -->
    <TextView
        android:id="@+id/tv_user"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/btn_insert"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:padding="8dp"
        android:background="#EFEFEF"
        android:textColor="@color/black"
        android:textSize="13sp"
        android:visibility="gone" />

    <!-- Action Buttons for Selected User -->
    <Button
        android:id="@+id/btn_delete"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="刪除單筆帳號"
        app:layout_constraintTop_toBottomOf="@+id/tv_user"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="6dp"
        android:layout_marginStart="8dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_insert_favorites"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="新增我的最愛"
        app:layout_constraintTop_toBottomOf="@+id/tv_user"
        app:layout_constraintStart_toEndOf="@+id/btn_delete"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btn_insert_history"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="新增歷史"
        app:layout_constraintTop_toBottomOf="@+id/tv_user"
        app:layout_constraintStart_toEndOf="@+id/btn_insert_favorites"
        android:layout_marginTop="6dp"
        android:layout_marginStart="6dp"
        android:visibility="gone" />

    <!-- RecyclerView for User List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@+id/btn_delete"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

</androidx.constraintlayout.widget.ConstraintLayout>