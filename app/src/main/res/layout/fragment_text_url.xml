<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_bg_all_20_1f1f1f"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:contentDescription="連結圖示"
                android:src="@drawable/ic_link" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="字串網址識別與高亮點擊"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="自動識別 URL、Email、電話號碼並提供點擊互動"
                    android:textColor="#9AA0A6"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Input & Presets Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_bg_all_20_1f1f1f"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="測試文字範本 (Presets)"
                android:textColor="#9AA0A6"
                android:textSize="12sp" />

            <!-- Preset Chips Horizontal Grid -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/chip_multi_url"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_template"
                    android:gravity="center"
                    android:text="🌐 多網址範本"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chip_contact"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_marginEnd="6dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_template"
                    android:gravity="center"
                    android:text="📧 聯絡資訊"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/chip_html"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_template"
                    android:gravity="center"
                    android:text="🏷️ HTML 連結"
                    android:textColor="#E0E0E0"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="輸入或貼上文字 (Editable Content)"
                android:textColor="#E0E0E0"
                android:textSize="13sp"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/ed_input_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_edit_text"
                android:gravity="top|start"
                android:hint="輸入包含 URL、Email 或電話的字串..."
                android:inputType="textMultiLine"
                android:minLines="3"
                android:maxLines="6"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:textColor="@color/white"
                android:textColorHint="#757575"
                android:textSize="13sp" />

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_parse"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_primary"
                    android:text="⚡ 立即解析並高亮"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_clear"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:background="@drawable/bg_btn_cancel"
                    android:minWidth="70dp"
                    android:text="清空"
                    android:textColor="#B0BEC5"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Output Rendered Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/panel_bg_all_20_1f1f1f"
            android:orientation="vertical"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="✨ 高亮互動結果 (點擊直接跳轉)"
                    android:textColor="#E0E0E0"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <Button
                    android:id="@+id/btn_copy_all"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_btn_cancel"
                    android:paddingHorizontal="10dp"
                    android:text="複製文字"
                    android:textColor="#03DAC5"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tv_url"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_edit_text"
                android:fadeScrollbars="false"
                android:gravity="top|start"
                android:lineSpacingExtra="4dp"
                android:minLines="3"
                android:padding="12dp"
                android:scrollbars="vertical"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Extracted Links Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/panel_bg_all_20_1f1f1f"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/tv_links_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔗 已偵測連結清單 (0)"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_empty_links"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:padding="16dp"
                android:text="目前文字中未偵測到任何連結"
                android:textColor="#757575"
                android:textSize="13sp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_links"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false"
                android:visibility="gone"
                tools:itemCount="2"
                tools:listitem="@layout/item_text_url_link"
                tools:visibility="visible" />
        </LinearLayout>

    </LinearLayout>

</androidx.core.widget.NestedScrollView>