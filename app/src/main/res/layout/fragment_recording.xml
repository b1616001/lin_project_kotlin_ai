<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F7FA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Top Header Bar -->
        <LinearLayout
            android:id="@+id/layoutHeader"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@color/white"
            android:elevation="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="返回"
                android:src="@drawable/ic_arrow_back"
                app:tint="#212121" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="語音錄製與播放"
                    android:textColor="#212121"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="即時音波視覺化與高音質錄放"
                    android:textColor="#757575"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_badge_pill"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="待命中"
                android:textColor="#019889"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Main Recording Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_horizontal"
                        android:orientation="vertical"
                        android:padding="24dp">

                        <!-- Digital Timer (Preserves @+id/tv_time) -->
                        <TextView
                            android:id="@+id/tv_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="monospace"
                            android:text="00:00:00"
                            android:textColor="#212121"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <!-- Decibel & Recording state subtitle -->
                        <TextView
                            android:id="@+id/tvDecibel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="準備錄音 (點擊下方麥克風)"
                            android:textColor="#757575"
                            android:textSize="13sp" />

                        <!-- Dynamic Sound Waveform Bars -->
                        <LinearLayout
                            android:id="@+id/layoutWaveform"
                            android:layout_width="wrap_content"
                            android:layout_height="48dp"
                            android:layout_marginTop="20dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <View
                                android:id="@+id/waveBar1"
                                android:layout_width="4dp"
                                android:layout_height="8dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/bg_waveform_bar" />

                            <View
                                android:id="@+id/waveBar2"
                                android:layout_width="4dp"
                                android:layout_height="14dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/bg_waveform_bar" />

                            <View
                                android:id="@+id/waveBar3"
                                android:layout_width="4dp"
                                android:layout_height="22dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/bg_waveform_bar" />

                            <View
                                android:id="@+id/waveBar4"
                                android:layout_width="4dp"
                                android:layout_height="32dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/bg_waveform_bar" />

                            <View
                                android:id="@+id/waveBar5"
                                android:layout_width="4dp"
                                android:layout_height="42dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/bg_waveform_bar" />

                            <View
                                android:id="@+id/waveBar6"
                                android:layout_width="4dp"
                                android:layout_height="32dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/bg_waveform_bar" />

                            <View
                                android:id="@+id/waveBar7"
                                android:layout_width="4dp"
                                android:layout_height="22dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/bg_waveform_bar" />

                            <View
                                android:id="@+id/waveBar8"
                                android:layout_width="4dp"
                                android:layout_height="14dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/bg_waveform_bar" />

                            <View
                                android:id="@+id/waveBar9"
                                android:layout_width="4dp"
                                android:layout_height="8dp"
                                android:layout_marginHorizontal="3dp"
                                android:background="@drawable/bg_waveform_bar" />
                        </LinearLayout>

                        <!-- Circular Record Button (Preserves @+id/checkbox) -->
                        <FrameLayout
                            android:layout_width="110dp"
                            android:layout_height="110dp"
                            android:layout_marginTop="24dp">

                            <CheckBox
                                android:id="@+id/checkbox"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_record_button_idle"
                                android:button="@null"
                                android:checked="false"
                                android:contentDescription="錄音開關" />

                            <ImageView
                                android:id="@+id/ivRecordIcon"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_mic"
                                app:tint="@color/white" />
                        </FrameLayout>

                        <TextView
                            android:id="@+id/tvRecordHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:text="點擊開始錄音"
                            android:textColor="#546E7A"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Audio Playback Card -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/cardPlayback"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="3dp"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="32dp"
                                android:layout_height="32dp"
                                android:src="@drawable/ic_music_note"
                                app:tint="#019889" />

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvAudioTitle"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="middle"
                                    android:singleLine="true"
                                    android:text="目前錄音檔"
                                    android:textColor="#212121"
                                    android:textSize="15sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tvAudioInfo"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="格式: AAC / M4A | 尚未有錄音"
                                    android:textColor="#757575"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <ImageButton
                                android:id="@+id/btnDeleteCurrent"
                                android:layout_width="36dp"
                                android:layout_height="36dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="刪除"
                                android:src="@drawable/ic_delete"
                                app:tint="#E53935" />
                        </LinearLayout>

                        <!-- Playback Progress Slider -->
                        <SeekBar
                            android:id="@+id/seekBarAudio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="16dp"
                            android:max="100"
                            android:progress="0"
                            android:progressBackgroundTint="#CFD8DC"
                            android:progressTint="#019889"
                            android:thumbTint="#019889" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvProgressCurrent"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="00:00"
                                android:textColor="#78909C"
                                android:textSize="12sp" />

                            <TextView
                                android:id="@+id/tvProgressTotal"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00:00"
                                android:textColor="#78909C"
                                android:textSize="12sp" />
                        </LinearLayout>

                        <!-- Playback Controls (Preserves @+id/btn_Play) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="14dp"
                            android:gravity="center"
                            android:orientation="horizontal">

                            <Button
                                android:id="@+id/btnReplay"
                                android:layout_width="wrap_content"
                                android:layout_height="44dp"
                                android:background="@drawable/bg_button_secondary"
                                android:drawableStart="@drawable/ic_replay"
                                android:drawablePadding="6dp"
                                android:paddingHorizontal="14dp"
                                android:text="重播"
                                android:textColor="#37474F"
                                android:textSize="13sp" />

                            <Button
                                android:id="@+id/btn_Play"
                                android:layout_width="140dp"
                                android:layout_height="44dp"
                                android:layout_marginStart="14dp"
                                android:background="@drawable/bg_btn_primary"
                                android:drawableStart="@drawable/ic_play_arrow"
                                android:drawablePadding="6dp"
                                android:drawableTint="@color/white"
                                android:paddingHorizontal="16dp"
                                android:text="播放錄音"
                                android:textColor="@color/white"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- Recording Tips Card -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardUseCompatPadding="true"
                    app:cardBackgroundColor="@color/white">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="錄音小提示"
                            android:textColor="#37474F"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:lineSpacingExtra="4dp"
                            android:text="• 採用 AAC 高音質編碼與 44.1kHz 取樣率。\n• 錄音時請靠近裝置麥克風，音波將根據即時振幅跳動。\n• 檔案儲存於應用專屬安全目錄，支援多次重播與進度拖曳。"
                            android:textColor="#757575"
                            android:textSize="12sp" />
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>